# URL de l'API Laravel. Les variables préfixées EXPO_PUBLIC_ sont
# embarquées telles quelles dans le bundle client (elles ne sont donc
# jamais secrètes) — voir src/services/api.js.
#
# - Aperçu web (`npx expo start --web`, même machine que le backend) :
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
#
# - Émulateur Android (127.0.0.1 y pointe vers l'émulateur lui-même) :
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
# - Appareil physique via Expo Go (même réseau Wi-Fi que le backend) :
# EXPO_PUBLIC_API_URL=http://<IP_LAN_DE_VOTRE_PC>:8000/api
