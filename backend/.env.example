# Modèle de configuration pour un déploiement en production — toutes les
# variables réellement utilisées par ce projet (hors valeurs par défaut du
# squelette Laravel qui ne sont jamais lues ici : Redis, Memcached, SQS,
# Beanstalkd, Postmark, Resend, Slack... ne figurent pas, volontairement).
# Compatible Railway et Render : les notes spécifiques à chacun sont
# indiquées à côté de la variable concernée.

APP_NAME="Backend SCKOLARIS"
APP_ENV=production
# Ne jamais réutiliser cette valeur en production : générer une clé propre
# avec `php artisan key:generate --show` et la coller telle quelle.
APP_KEY=base64:m9BuV3M3aTIXPcxMIPx0MW98XJPevdnH6qUXgn4LbYA=
APP_DEBUG=false
# URL publique de CE service (jamais celle du frontend) :
#   Railway : Settings > Networking > Public Networking > Generate Domain
#   Render  : visible en haut du service une fois le premier déploiement
#             terminé (https://<nom-du-service>.onrender.com) — renseigner
#             cette variable APRÈS ce premier déploiement, puis redéployer.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr (pas stack/single) : sur Railway comme sur Render, les fichiers de
# logs écrits dans storage/ ne sont jamais consultables depuis le tableau de
# bord — seule la sortie standard du conteneur l'est.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de données (PostgreSQL) ---
DB_CONNECTION=pgsql
# Option A (recommandée, surtout sur Render) : une seule variable avec la
# chaîne de connexion complète fournie par l'hébergeur. Si DB_URL est
# définie, elle prime sur les 5 variables DB_HOST/PORT/DATABASE/USERNAME/
# PASSWORD ci-dessous (voir config/database.php) — inutile de les dupliquer.
#   Render  : Postgres > Connect > "Internal Database URL", à coller ici.
#   Railway : Postgres > Variables > DATABASE_URL (équivalent).
# DB_URL=postgresql://user:password@host:5432/database
#
# Option B : variables séparées (utile si l'hébergeur ne fournit pas d'URL
# unique, ou pour du debug). Sur Railway, ces références ${{Postgres.PGHOST}}
# etc. sont résolues automatiquement si un service Postgres du même projet
# porte le nom "Postgres" ; sur Render, remplacer par les valeurs exactes de
# l'onglet "Connect" du service Postgres (host interne, pas externe).
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- CORS / Sanctum (auth SPA du frontend web) ---
# Origines autorisées à appeler l'API depuis un navigateur (frontend-web sur
# Vercel), séparées par des virgules, sans slash final. Sans ça, le
# navigateur bloque toutes les requêtes (l'API et le frontend-web ne sont
# pas sur le même domaine). N'affecte pas le mobile/desktop (pas de CORS
# en dehors des navigateurs).
CORS_ALLOWED_ORIGINS=https://sckolaris.vercel.app
# Mêmes domaines que CORS_ALLOWED_ORIGINS, mais SANS le schéma https:// et
# séparés par des virgules s'il y en a plusieurs. Sans cette variable,
# l'authentification Sanctum échoue de façon peu explicite.
SANCTUM_STATEFUL_DOMAINS=sckolaris.vercel.app

# Sert à construire le lien cliquable envoyé dans l'e-mail de
# réinitialisation de mot de passe (voir ResetPasswordNotification) et le
# logo des e-mails (voir App\Support\EmailBranding) — doit être l'URL du
# site web (frontend-web), pas celle de cette API.
FRONTEND_URL=https://sckolaris.vercel.app

# --- Assistant IA (Sckolaris AI) ---
# Clé Google AI Studio (aistudio.google.com/apikey) — niveau gratuit, utilisée
# par l'assistant chat (ChatController) et par la recherche sémantique dans
# le contenu des documents (DocumentRagService, embeddings). La recherche
# documentaire plateforme (ProjectRagService) ne dépend d'aucune clé. Ne
# jamais exposer cette variable au frontend (pas de VITE_).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Taille max. (Mo) d'un document indexé pour l'IA — au-delà, marqué
# "too_large" sans tentative d'extraction. Voir DocumentRagService.
AI_MAX_INDEXABLE_FILE_MB=100

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# ⚠️ Le disque 'local' écrit dans storage/app, qui est éphémère : tout
# document déposé est perdu au prochain déploiement/redémarrage, sauf si un
# volume persistant est monté sur ce chemin.
#   Railway : Service > Settings > Volumes, mount path /app/storage/app.
#   Render  : Service > Disks, mount path /app/storage/app (disque payant,
#             non disponible sur le plan gratuit — prévoir S3 sinon, voir
#             les variables AWS_* plus bas).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- E-mail (Brevo, API HTTPS — voir App\Notifications\Channels\BrevoChannel) ---
# Les notifications (validation de compte, réinitialisation de mot de passe,
# nouveau support, décision de suppression) passent par l'API HTTPS de
# Brevo, pas par SMTP : MAIL_MAILER/MAIL_HOST/MAIL_PORT ne sont pas utilisés
# pour elles. Créer la clé sur brevo.com > Paramètres > SMTP & API > API Keys.
# ⚠️ Désactiver la restriction par adresse IP de Brevo (Security > Authorized
# IPs) : les hébergeurs comme Railway/Render n'ont pas d'IP de sortie fixe,
# Brevo refuserait sinon l'envoi avec une erreur 401.
BREVO_API_KEY=
# Doit être un expéditeur vérifié dans Brevo (Senders & IP), sinon Brevo
# refuse l'envoi. Valeur littérale, jamais "${APP_NAME}" : cette
# interpolation ne fonctionne que si l'hébergeur charge un vrai fichier
# .env — Render et Railway injectent les variables directement, sans
# interpolation.
MAIL_FROM_ADDRESS="contact@sckolaris.com"
MAIL_FROM_NAME="SCKOLARIS"
# Destination du formulaire de contact (ContactController) — actuellement
# non branché côté frontend (voir Contact.jsx), prêt si rebranché un jour.
CONTACT_EMAIL=contact@sckolaris.com

# --- Stockage S3 (optionnel — alternative à FILESYSTEM_DISK=local ci-dessus) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Releases desktop/mobile (voir App\Http\Middleware\ReleaseAccess) ---
# Jeton fixe permettant de publier/retirer un installeur desktop ou mobile
# (POST/DELETE /api/app-releases) sans compte admin de l'application —
# généré une fois avec `openssl rand -hex 32`, à conserver dans un
# gestionnaire de mots de passe.
RELEASE_UPLOAD_TOKEN=

# --- Statistiques détaillées (voir StatsController, backend/r-scripts/) ---
# 'Rscript' suffit si R est installé et sur le PATH du conteneur (c'est le
# cas avec backend/Dockerfile, qui installe r-base) — ne concerne que les
# environnements où PHP ne reprend pas le PATH système (ex: Laravel Herd en
# local sous Windows).
RSCRIPT_BIN=Rscript
