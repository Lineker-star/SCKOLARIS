APP_NAME="Backend SCKOLARIS"
APP_ENV=production
# Ne pas réutiliser cette valeur en production : générer une clé propre à
# Railway avec `php artisan key:generate --show` et la coller telle quelle.
APP_KEY=base64:m9BuV3M3aTIXPcxMIPx0MW98XJPevdnH6qUXgn4LbYA=
APP_DEBUG=false
# URL publique fournie par Railway pour ce service (Settings > Networking >
# Public Networking > Generate Domain), ex: https://e-biblio-backend-production.up.railway.app
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Origines autorisées à appeler l'API depuis un navigateur (frontend-web sur
# Vercel), séparées par des virgules, sans slash final. Sans ça, le
# navigateur bloque toutes les requêtes (l'API et le frontend-web ne sont
# pas sur le même domaine). N'affecte pas le mobile/desktop (pas de CORS
# en dehors des navigateurs).
CORS_ALLOWED_ORIGINS=https://e-biblio.vercel.app

# Sert à construire le lien cliquable envoyé dans l'e-mail de
# réinitialisation de mot de passe (voir ResetPasswordNotification) — doit
# être l'URL du site web (frontend-web), pas celle de l'API.
FRONTEND_URL=https://e-biblio.vercel.app

# Clé Google AI Studio (aistudio.google.com/apikey) — niveau gratuit, utilisée
# par l'assistant chat (ChatController). La recherche documentaire (RAG) ne
# dépend d'aucune clé : voir ProjectRagService. Ne jamais exposer cette
# variable au frontend (pas de VITE_).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# ⚠️ Le disque 'local' écrit dans storage/app, qui est éphémère sur Railway :
# tout document déposé est perdu au prochain déploiement/redémarrage, sauf
# si un Volume Railway est monté sur ce chemin (Service > Settings > Volumes,
# mount path: /app/storage/app). Sans volume, prévoir S3 (variables AWS_*
# ci-dessous) à la place.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

# En production, pour que la réinitialisation de mot de passe (et le
# formulaire de contact, si ContactController est un jour rebranché) envoie
# réellement un courriel : créer un compte gratuit sur brevo.com, récupérer
# une clé SMTP (Paramètres > SMTP & API > SMTP), puis
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<identifiant SMTP Brevo>
#   MAIL_PASSWORD=<clé SMTP générée, pas le mot de passe du compte>
#   MAIL_SCHEME=null
#   MAIL_FROM_ADDRESS=biblio@iu-ztf.cm
# Contrairement à Resend, Brevo envoie vers n'importe quel destinataire dès
# la création du compte (pas de mode sandbox limité à sa propre adresse) —
# aucun package Composer supplémentaire requis, Laravel gère le SMTP en natif.
# Laravel 12 utilise `MAIL_SCHEME` dans config/mail.php. Ne pas compter sur
# `MAIL_ENCRYPTION`, qui n'est pas lu par cette configuration. Avec le port
# 587, le transport SMTP négocie STARTTLS avec Brevo.
# Avec MAIL_MAILER=log (par défaut), rien n'est envoyé — le message est
# seulement écrit dans storage/logs/laravel.log, pratique en local.
CONTACT_EMAIL=biblio@iu-ztf.cm

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# En local (Windows), si Rscript n'est pas sur le PATH du processus qui sert
# PHP (ex: Laravel Herd), mettre le chemin complet - voir la note dans
# config/services.php. Ex: RSCRIPT_BIN="C:\Program Files\R\R-4.x.x\bin\Rscript.exe"
RSCRIPT_BIN=Rscript
