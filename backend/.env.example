# Modèle de configuration pour un déploiement en production — toutes les
# variables réellement utilisées par ce projet (hors valeurs par défaut du
# squelette Laravel qui ne sont jamais lues ici : Redis, Memcached, SQS,
# Beanstalkd, Postmark, Resend, Slack... ne figurent pas, volontairement).
# Compatible Railway et Render : les notes spécifiques à chacun sont
# indiquées à côté de la variable concernée.

APP_NAME="Backend SCKOLARIS"
APP_ENV=production
# Ne jamais réutiliser cette valeur en production : générer une clé propre
# avec `php artisan key:generate --show` et la coller telle quelle.
APP_KEY=base64:k4N03H66ajaY3hvN0JW+M8nl2kzSnCnPOlz+Mvs6JcY=
APP_DEBUG=false
# URL publique de CE service (jamais celle du frontend) :
#   Railway : Settings > Networking > Public Networking > Generate Domain
#   Render  : visible en haut du service une fois le premier déploiement
#             terminé (https://<nom-du-service>.onrender.com) — renseigner
#             cette variable APRÈS ce premier déploiement, puis redéployer.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr (pas stack/single) : sur Railway comme sur Render, les fichiers de
# logs écrits dans storage/ ne sont jamais consultables depuis le tableau de
# bord — seule la sortie standard du conteneur l'est.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de données (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Domaine personnalisé www.sckolaris.online + domaines Vercel par défaut
# gardés en secours (Vercel les laisse toujours actifs en plus d'un domaine
# personnalisé). sckolaris.online (sans www) fait une redirection 308 vers
# www.sckolaris.online : c'est ce dernier qui charge réellement l'app et
# dont le navigateur envoie l'en-tête Origin — les deux formes sont listées
# par prudence.
CORS_ALLOWED_ORIGINS=https://www.sckolaris.online,https://sckolaris.online,https://sckolaris.vercel.app

# Sanctum veut des noms d'hôte nus (sans https://), contrairement à
# CORS_ALLOWED_ORIGINS ci-dessus.
SANCTUM_STATEFUL_DOMAINS=www.sckolaris.online,sckolaris.online,sckolaris.vercel.app

# Valeur unique (liens dans les e-mails, logo) : le domaine principal.
FRONTEND_URL=https://www.sckolaris.online


GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

AI_MAX_INDEXABLE_FILE_MB=100

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database


BREVO_API_KEY=

MAIL_FROM_ADDRESS="ztfuniversityinstitute@gmail.com"
MAIL_FROM_NAME="SCKOLARIS"
# Destination du formulaire de contact (ContactController), branché côté
# frontend (voir Contact.jsx).
CONTACT_EMAIL=ztfuniversityinstitute@gmail.com

# --- Stockage S3 (optionnel — alternative à FILESYSTEM_DISK=local ci-dessus) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Releases desktop/mobile (voir App\Http\Middleware\ReleaseAccess) ---
# Jeton fixe permettant de publier/retirer un installeur desktop ou mobile
# (POST/DELETE /api/app-releases) sans compte admin de l'application —
# généré une fois avec `openssl rand -hex 32`, à conserver dans un
# gestionnaire de mots de passe.
RELEASE_UPLOAD_TOKEN=

# --- Statistiques détaillées (voir StatsController, backend/r-scripts/) ---
# 'Rscript' suffit si R est installé et sur le PATH du conteneur (c'est le
# cas avec backend/Dockerfile, qui installe r-base) — ne concerne que les
# environnements où PHP ne reprend pas le PATH système (ex: Laravel Herd en
# local sous Windows).
RSCRIPT_BIN=Rscript
